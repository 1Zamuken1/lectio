# Copia este archivo como .env (no se versiona). Valores para docker-compose.yml.

# Base de datos (Postgres) y colas (Redis)
DATABASE_URL=postgresql://lectio:lectio@localhost:5432/lectio
TEST_DATABASE_URL=postgresql://lectio:lectio@localhost:5432/lectio_test
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
# Orígenes que pueden llamar a la API con credenciales (separados por coma)
CORS_ORIGINS=http://localhost:4173,http://localhost:5173

# Sesión: secreto para firmar los access token (genera uno con: openssl rand -base64 48)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Duración de la sesión
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Storage local (por defecto, storage/ en la raíz) y tamaño máximo de un EPUB
# STORAGE_DIR=
MAX_UPLOAD_MB=50

# Audio: motor de voz (edge o silent, sin red), cuota mensual y límites de generación
TTS_PROVIDER=edge
TTS_MONTHLY_QUOTA=300000
AUDIO_MAX_PER_USER=2
AUDIO_WORKER_CONCURRENCY=2
TTS_REQUESTS_PER_CHAPTER=2
AUDIO_JOB_ATTEMPTS=3
MEDIA_URL_TTL_SECONDS=3600
