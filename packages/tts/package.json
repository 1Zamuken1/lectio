{
  "name": "@lectio/tts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Síntesis de voz de Lectio: adaptador de Edge TTS, perfiles de voz y montaje MP3 por unidades.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lectio/epub-pipeline": "workspace:*",
    "msedge-tts": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
