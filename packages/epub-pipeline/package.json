{
  "name": "@lectio/epub-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Procesamiento de EPUB: estructura, limpieza, oraciones y alineación para narración.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.1",
    "linkedom": "^0.18.13",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "yazl": "^3.3.1"
  }
}
