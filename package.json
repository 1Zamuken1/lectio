{
  "name": "lectio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && turbo run typecheck test",
    "corpus:download": "node scripts/download-corpus.mjs",
    "lectio": "pnpm --silent --filter @lectio/cli dev",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
