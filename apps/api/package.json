{
  "name": "@lectio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP de Lectio (NestJS): solo atiende peticiones y encola trabajos.",
  "scripts": {
    "dev": "node --conditions=source --import @swc-node/register/esm-register --watch-path=src --watch-path=../../packages/core/src --watch-path=../../packages/epub-pipeline/src --watch-path=../../packages/tts/src src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "openapi": "node --conditions=source --import @swc-node/register/esm-register src/openapi.ts ../web/src/api/openapi.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@lectio/core": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/jwt": "^12.0.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "bullmq": "^6.3.9",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
